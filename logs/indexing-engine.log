2026-08-03 16:49:56.0683 - DEBUG - graphrag.api.index - {'entities': [{'id': '3739d331-4ed5-46fd-9b66-f9f05d34c320', 'human_readable_id': 0, 'title': 'AMAZON', 'type': 'ORGANIZATION', 'description': "Amazon is a leading online marketplace that has significantly impacted the eCommerce landscape worldwide, particularly in Western markets. With its extensive market share and innovative price comparison features, Amazon has transformed the shopping experience by providing consumers with a convenient platform for purchasing a vast array of products.\n\nIn addition to its dominant presence in Western markets, Amazon plays a major role in the traditional e-commerce landscape in India. The company offers a wide variety of products, catering to the diverse needs of Indian consumers. It ensures a standard delivery timeframe, enhancing the shopping experience by promoting reliability and convenience. Overall, Amazon's influence spans across global markets, making it a pivotal entity in the evolution of online shopping.", 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712', '4ca5b66ee1dc513e98933240d57ecfe730232c1e1cd9e4016cfd5127a1b4e6105f1eae9296b49be0f9495f3bdb8914492afa2d5bdd8885ebafd5f3643c575f39'], 'frequency': 2, 'degree': 3}, {'id': 'be1ab68f-95f8-4874-8313-4e99ae683bbe', 'human_readable_id': 1, 'title': 'ALIBABA', 'type': 'ORGANIZATION', 'description': 'Alibaba is a significant player in the eCommerce landscape, recognized for its efficient marketplace that provides both transactional buying and experiential shopping environments.', 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712'], 'frequency': 1, 'degree': 2}, {'id': 'c751bc46-6406-4783-b353-b3a0f7193044', 'human_readable_id': 2, 'title': 'ECOMMERCE', 'type': 'EVENT', 'description': 'eCommerce is the process of buying and selling goods or services online, which has transformed traditional retail by introducing convenience and efficiency.', 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712'], 'frequency': 1, 'degree': 2}, {'id': '8e2d3535-5ca7-43d8-b56f-9f5593017e2f', 'human_readable_id': 3, 'title': 'SHOPPING', 'type': 'EVENT', 'description': 'Shopping is an experiential process involving discovering and exploring products in a social setting, often rewarding through enjoyable experiences and personal interactions.', 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712'], 'frequency': 1, 'degree': 0}, {'id': '2fe82f6d-4381-4daa-8b68-a68b1b552d23', 'human_readable_id': 4, 'title': 'CUSTOMER BEHAVIOR', 'type': 'EVENT', 'description': 'Customer behavior describes how individuals make decisions to spend their available resources on consumption-related items, which can be influenced by habits and unconscious choices.', 'text_unit_ids': ['4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850'], 'frequency': 1, 'degree': 2}], 'relationships': [{'id': '5c68a608-5e35-4b81-a818-490164f2edd2', 'human_readable_id': 0, 'source': 'AMAZON', 'target': 'ECOMMERCE', 'description': 'Amazon has pioneered features that define and lead eCommerce, making it a key contributor to the growth of online shopping experiences', 'weight': 8.0, 'combined_degree': 5, 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712']}, {'id': 'e8cdc53b-eb4e-4162-bfb4-5c854c3f8f89', 'human_readable_id': 1, 'source': 'ALIBABA', 'target': 'ECOMMERCE', 'description': 'Alibaba is also a major contributor to the evolution and expansion of eCommerce practices worldwide', 'weight': 8.0, 'combined_degree': 4, 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712']}, {'id': 'a65292fb-6df2-4a61-a3ea-ca4cabb1d88b', 'human_readable_id': 2, 'source': 'AMAZON', 'target': 'ALIBABA', 'description': 'Both Amazon and Alibaba are pioneers in the eCommerce industry, shaping the way online shopping is experienced by consumers', 'weight': 1.0, 'combined_degree': 5, 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712']}, {'id': '71a507e4-7e2d-45ee-af46-bf210caac4bf', 'human_readable_id': 3, 'source': 'CUSTOMER BEHAVIOR', 'target': 'HABITS', 'description': 'Customer behavior is often influenced by habits that automate decision-making processes.', 'weight': 8.0, 'combined_degree': 6, 'text_unit_ids': ['4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850']}, {'id': 'd073d9b6-4c9a-49cd-a08f-0d9bcfedcc91', 'human_readable_id': 4, 'source': 'HABITS', 'target': 'CLAYTON CHRISTENSEN', 'description': "Clayton Christensen's framework explains how habits form and influence consumer behaviors in making purchasing decisions.", 'weight': 7.0, 'combined_degree': 5, 'text_unit_ids': ['4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850']}]}
