2026-08-03 14:12:49.0550 - DEBUG - graphrag.api.index - {'entities': [{'id': 'a7af4c40-095c-4222-ae6e-1faaf52ac5d7', 'human_readable_id': 0, 'title': 'AMAZON', 'type': 'ORGANIZATION', 'description': 'Amazon is a leading global online marketplace that dominates the buying sector by prioritizing efficiency, price comparison, and customer convenience. Beyond its global reach, Amazon operates as a major traditional e-commerce marketplace in India, where it is recognized for providing a vast, long-tail selection of products supported by an extensive national logistics network. By integrating its global standards for operational excellence with localized service capabilities, Amazon maintains a significant presence in both international and regional markets.', 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712', '4ca5b66ee1dc513e98933240d57ecfe730232c1e1cd9e4016cfd5127a1b4e6105f1eae9296b49be0f9495f3bdb8914492afa2d5bdd8885ebafd5f3643c575f39'], 'frequency': 2, 'degree': 4}, {'id': '133bcf09-7277-48a9-97a2-10ec27f3bef6', 'human_readable_id': 1, 'title': 'ALIBABA', 'type': 'ORGANIZATION', 'description': 'Alibaba is a prominent global eCommerce corporation and industry pioneer that serves as a cornerstone for search and consumer market intent. Recognized for its significant influence in the digital marketplace, Alibaba acts as a vital platform that effectively bridges the gap between commercial search activity and consumer behavior.', 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712', '9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712'], 'frequency': 2, 'degree': 2}, {'id': 'c1ccc24f-72ff-4b43-b77b-aa8658f343ba', 'human_readable_id': 2, 'title': 'RETAIL', 'type': 'ORGANIZATION', 'description': 'The broad sector of commerce currently undergoing a radical transformation and shifting focus toward omnichannel strategies.', 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712'], 'frequency': 1, 'degree': 2}, {'id': 'f94eef2b-2646-4c89-87db-eeac451f099a', 'human_readable_id': 3, 'title': 'CLAYTON CHRISTENSEN', 'type': 'PERSON', 'description': 'A theorist and academic whose framework of ‘jobs to be done’ is utilized to operationalize and understand customer behavior.', 'text_unit_ids': ['4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850', '4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850'], 'frequency': 2, 'degree': 1}, {'id': '0055ae72-bc30-4be9-8314-009e0d616f0a', 'human_readable_id': 4, 'title': 'UBER', 'type': 'ORGANIZATION', 'description': "A service-based company cited as an example of a mode of transport used by consumers to complete the 'job' of getting to work.", 'text_unit_ids': ['4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850', '4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850'], 'frequency': 2, 'degree': 1}], 'relationships': [{'id': '13d18494-336c-4602-880a-a25af07aab19', 'human_readable_id': 0, 'source': 'AMAZON', 'target': 'ALIBABA', 'description': 'Both AMAZON and ALIBABA are recognized as industry pioneers that demonstrate a sophisticated understanding of the consumer experience. Specifically, both companies distinguish between the transactional act of buying and the experiential process of shopping, tailoring their platforms to address both the functional necessity of procurement and the engagement inherent in the shopping journey.', 'weight': 9.0, 'combined_degree': 6, 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712', '9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712']}, {'id': '03bebb25-a987-4333-ad08-896959b9a00d', 'human_readable_id': 1, 'source': 'AMAZON', 'target': 'RETAIL', 'description': 'Amazon is a major participant in the retail sector that is driving the ongoing radical transformation of the industry', 'weight': 6.0, 'combined_degree': 6, 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712']}, {'id': '51684b3b-a065-43c2-a919-67742a00a1f0', 'human_readable_id': 2, 'source': 'ALIBABA', 'target': 'RETAIL', 'description': 'Alibaba is an industry pioneer that influences the transformation and search-based evolution of the retail market', 'weight': 1.0, 'combined_degree': 4, 'text_unit_ids': ['9a565f901eae5509396303ee34d648b1f8e2dc83e161c29346865408503d471a74b785705df5d48672a2d815e46a4fcb1cac6dae5f76173f8fdfd24c77f77712']}, {'id': '969aadfc-12c9-48eb-aef5-4aac5914ee78', 'human_readable_id': 3, 'source': 'CLAYTON CHRISTENSEN', 'target': 'QUICK COMMERCE', 'description': 'The "jobs to be done" framework, developed by Clayton Christensen, serves as a vital analytical tool for marketers operating within the Quick Commerce sector. By focusing on the underlying motivations that drive individuals to purchase specific products or services, this framework allows businesses to better understand and cater to consumer behavior within modern retail models. Clayton Christensen’s methodology helps Quick Commerce companies identify the specific "job" a customer is trying to accomplish, thereby enabling them to optimize their delivery speeds and service offerings to meet these needs effectively in an increasingly fast-paced digital marketplace.', 'weight': 8.0, 'combined_degree': 16, 'text_unit_ids': ['4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850', '4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850']}, {'id': 'a404bd3b-9fb1-4db6-a750-f15249d82af0', 'human_readable_id': 4, 'source': 'UBER', 'target': 'QUICK COMMERCE', 'description': 'Uber and Quick Commerce are both categorized as on-demand service platforms that rely heavily on established, habitual consumer usage patterns to achieve success. Both entities function as service-oriented models designed to fulfill specific "jobs to be done" for the user, effectively integrating themselves into the daily routines of their target audiences. By leveraging these recurring consumption habits, Uber and Quick Commerce maintain their market relevance and operational sustainability.', 'weight': 5.0, 'combined_degree': 16, 'text_unit_ids': ['4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850', '4946a6a2a3640b7529f693a39a1ad0803d53c105d0ee59e22ad3820044594a62cb7b8929fcccbd884447beebc8d8e30c70cd43b61620871fc9b02f9de7f3f850']}]}
